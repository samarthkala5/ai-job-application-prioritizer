%% Planned COMPLETE architecture
%% Green solid = implemented (Phase 0 / Phase 1). Grey dashed = PLANNED, not implemented.
%% Planned components follow README.md "Next Planned Components" and the gaps found in Phase 1 validation.
flowchart TB
    subgraph IN["Input"]
        R["Resume<br/>PDF / DOCX / text"]
        J["Job descriptions"]
    end

    PARSE["Text extraction<br/>PyMuPDF / python-docx"]

    subgraph SIG["Matching signals"]
        SEM["Semantic similarity<br/>SBERT all-MiniLM-L6-v2 + cosine"]
        TRUNC["Long-document handling<br/>(chunk / section-wise embedding)"]
        SK["Skill extraction + matching<br/>ontology, matched / missing, coverage"]
        SEC["Required vs preferred<br/>section parsing"]
        ONTX["Ontology expansion<br/>+ skill weighting"]
        EXP["Experience & project<br/>relevance / proficiency evidence"]
    end

    subgraph DEC["Decision layer"]
        FIT["Hybrid fit score<br/>(only after independent validation)"]
        GAP["Skill-gap analysis<br/>+ explanations"]
        PRI["Application priority ranking"]
        PREP["Preparation recommendations"]
    end

    UI["Streamlit UI<br/>semantic ranking (implemented)<br/>skills / priority views (planned)"]

    subgraph LOOP["Learning loop"]
        DB[("Application tracking database")]
        FB["Outcome feedback<br/>+ personalisation"]
    end

    EVAL["Evaluation: larger dataset,<br/>independent multi-annotator labels"]

    R --> PARSE
    J --> PARSE
    PARSE --> SEM
    PARSE --> SK
    TRUNC -.-> SEM
    SEC -.-> SK
    ONTX -.-> SK
    PARSE -.-> EXP

    SEM -.-> FIT
    SK -.-> FIT
    EXP -.-> FIT
    SK -.-> GAP
    FIT -.-> PRI
    GAP -.-> PREP
    SEM --> UI
    PRI -.-> UI
    PREP -.-> UI
    GAP -.-> UI

    UI -.-> DB -.-> FB -.-> FIT
    EVAL -.-> FIT

    classDef impl fill:#e8f5e9,stroke:#2e7d32,color:#1b1b1b;
    classDef planned fill:#f5f5f5,stroke:#9e9e9e,color:#555555,stroke-dasharray: 5 4;
    class PARSE,SEM,SK,UI impl;
    class TRUNC,SEC,ONTX,EXP,FIT,GAP,PRI,PREP,DB,FB,EVAL planned;
